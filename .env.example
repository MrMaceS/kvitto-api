# Строка подключения к базе данных (для локальной разработки через docker-compose)
# Формат: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://kvitto:kvitto@localhost:5432/kvitto

# Секретный ключ для проверки HMAC-SHA256 подписи вебхуков от банка
# В production-окружении здесь должна быть сложная случайная строка
WEBHOOK_SECRET=super-secret-webhook-key

# Промокод для скидки (в коде проверка идет без учета регистра)
PROMO_CODE=KVITTO10

# Размер скидки в процентах (целое число)
PROMO_DISCOUNT_PERCENT=10